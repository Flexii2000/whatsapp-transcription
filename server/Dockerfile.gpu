# GPU-Variante. Unterschied zur CPU-Version: ctranslate2 (die Engine unter
# faster-whisper) braucht cuBLAS und cuDNN. Die kommen hier als pip-Wheels
# statt ueber ein CUDA-Basisimage — das haelt den Build einfach und laesst
# den NVIDIA-Treiber vom Host durchgereicht werden.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/models \
    OMP_NUM_THREADS=8

WORKDIR /srv

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
        nvidia-cublas-cu12==12.4.5.8 \
        nvidia-cudnn-cu12==9.1.0.70

# ctranslate2 sucht die Bibliotheken ueber den Loader-Pfad.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib

COPY app ./app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
