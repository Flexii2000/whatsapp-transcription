# --- Zugang ------------------------------------------------------------
# Muss mit dem Token in den Extension-Optionen uebereinstimmen.
# Erzeugen mit:  openssl rand -hex 32
AUTH_TOKEN=

# --- Claude (Executive Summary) ---------------------------------------
# Leer lassen => nur Transkript, keine Stichpunkte.
ANTHROPIC_API_KEY=
SUMMARY_ENABLED=true
SUMMARY_MODEL=claude-opus-5
SUMMARY_EFFORT=low
SUMMARY_MAX_BULLETS=5
# Kuerzere Memos ("Ja passt, bis gleich") bekommen keine Stichpunkte.
# Auf 0 setzen, wenn wirklich jede Nachricht zusammengefasst werden soll.
SUMMARY_MIN_WORDS=20

# --- Datenhaltung ------------------------------------------------------
# Audio wird nie gespeichert. Gespeichert werden nur sha256(Audio),
# Transkript und Stichpunkte. 0 = unbegrenzt aufheben, sonst Tage bis
# zum automatischen Loeschen.
CACHE_TTL_DAYS=0

# Leer lassen. Die Extension ruft aus ihrem Service-Worker auf und braucht
# kein CORS — ein offenes "*" waere nur unnoetige Angriffsflaeche.
CORS_ORIGINS=

# --- Whisper -----------------------------------------------------------
# large-v3-turbo = beste Qualitaet bei vertretbarem Tempo.
# Falls der Server zu langsam ist, absteigend: medium -> small -> base
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leer = Sprache automatisch erkennen. "de" erzwingt Deutsch.
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
MAX_CONCURRENCY=1
# Der Server hat 8 Kerne / 16 Threads. Bei MAX_CONCURRENCY=1 darf Whisper sie
# sich nehmen. Runtersetzen, wenn parallel andere Dienste Last brauchen.
OMP_NUM_THREADS=8

LOG_LEVEL=INFO
