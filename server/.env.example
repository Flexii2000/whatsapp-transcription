# --- Zugang ------------------------------------------------------------
# Muss mit dem Token in den Extension-Optionen uebereinstimmen.
# Erzeugen mit:  openssl rand -hex 32
AUTH_TOKEN=

# --- Zusammenfassung ---------------------------------------------------
# local   Eigenes Ollama im selben Compose-Stack. Kostenlos, und das
#         Transkript verlaesst den Server nicht. Standard.
# claude  Anthropic-API. Beste Qualitaet, braucht ANTHROPIC_API_KEY, und der
#         Transkript-Text geht an Anthropic.
# none    Nur Transkript, keine Stichpunkte.
SUMMARY_BACKEND=local

# Kuerzere Memos ("Ja passt, bis gleich") bekommen keine Stichpunkte.
# Auf 0 setzen, wenn wirklich jede Nachricht zusammengefasst werden soll.
SUMMARY_MIN_WORDS=20
SUMMARY_MAX_BULLETS=5

# --- SUMMARY_BACKEND=local ---------------------------------------------
# LLM_URL wird von docker-compose.yml gesetzt (http://llm:11434) und muss
# hier normalerweise nicht stehen.
#
# VRAM-Rechnung fuer die 6 GB der GTX 1660 SUPER, wenn beides auf der GPU
# laeuft:  Whisper float16 ~2,0 GB + 4B-Modell in Q4 ~2,8 GB = ~4,8 GB.
# Ein 7B/8B-Modell (~5 GB) passt NICHT zusaetzlich zu Whisper — dann
# entweder WHISPER_DEVICE=cpu setzen oder beim 4B bleiben.
LLM_MODEL=qwen3:4b
LLM_TIMEOUT=120

# --- SUMMARY_BACKEND=claude --------------------------------------------
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5
SUMMARY_EFFORT=low

# --- Datenhaltung ------------------------------------------------------
# Audio wird nie gespeichert. Gespeichert werden nur sha256(Audio),
# Transkript und Stichpunkte. 0 = unbegrenzt aufheben, sonst Tage bis
# zum automatischen Loeschen.
CACHE_TTL_DAYS=0

# Die Extension ruft aus ihrem Service-Worker auf und braucht kein CORS.
# Noetig ist es nur fuer das Statusboard, das /stats direkt im Browser
# abfragt. Leer = Standard (status.fherrmann.com). "none" schaltet CORS ab.
# Niemals "*" eintragen.
CORS_ORIGINS=https://status.fherrmann.com

# --- Whisper -----------------------------------------------------------
# large-v3-turbo = beste Qualitaet bei vertretbarem Tempo.
# Falls der Server zu langsam ist, absteigend: medium -> small -> base
WHISPER_MODEL=large-v3-turbo
# device/compute_type setzt docker-compose.gpu.yml auf cuda/float16.
# Ohne GPU bleibt es bei cpu/int8.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leer = Sprache automatisch erkennen. "de" erzwingt Deutsch.
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
MAX_CONCURRENCY=1
# Der Server hat 8 Kerne / 16 Threads. Bei MAX_CONCURRENCY=1 darf Whisper sie
# sich nehmen. Runtersetzen, wenn parallel andere Dienste Last brauchen.
OMP_NUM_THREADS=8

LOG_LEVEL=INFO
